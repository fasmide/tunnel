[Unit]
Description=Self-hosted reverse tunnel daemon
Documentation=https://www.freedesktop.org/software/systemd/man/systemd.exec.html
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
DynamicUser=yes
User=tunneld
StateDirectory=tunneld
StateDirectoryMode=0700
RuntimeDirectory=tunneld
RuntimeDirectoryMode=0700
WorkingDirectory=/var/lib/tunneld
UMask=0077

# REQUIRED: set your real transport DNS base below before starting.
# Left empty intentionally: tunneld refuses to start without a domain.
# The generated constrained CA and its key persist in StateDirectory.
Environment=TUNNELD_DOMAIN=
ExecStart=/usr/local/bin/tunneld --state ${STATE_DIRECTORY} --socket ${RUNTIME_DIRECTORY}/admin.sock --domain=${TUNNELD_DOMAIN} --quic :7443 --https :443 --http :80

Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
KillMode=control-group

# Public low ports are the only reason to retain a capability.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# StateDirectory remains writable under ProtectSystem=strict.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private

# Network access is necessary; AF_UNIX is also used by the admin socket.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tunneld

[Install]
WantedBy=multi-user.target
