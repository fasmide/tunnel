[Unit]
Description=Self-hosted tunnel proxy instance %i (environment file command)
Documentation=https://www.freedesktop.org/software/systemd/man/systemd.service.html
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
EnvironmentFile=%h/.config/tunnelproxy/%i.env
ExecStart=/bin/sh -eu -c 'exec %h/.local/bin/tunnelproxy "$COMMAND" --server "$SERVER" --name "$NAME" --state "$STATE" --target "$TARGET" --mode "$MODE" ${SERVER_NAME:+--server-name "$SERVER_NAME"} ${FINGERPRINT:+--fingerprint "$FINGERPRINT"} ${TOFU:+--tofu} ${ACME_EMAIL:+--acme-email "$ACME_EMAIL"} ${CERT:+--cert "$CERT"} ${KEY:+--key "$KEY"} ${SETUP_TIMEOUT:+--setup-timeout "$SETUP_TIMEOUT"} ${DRAIN_TIMEOUT:+--drain-timeout "$DRAIN_TIMEOUT"} ${TARGET_TIMEOUT:+--target-timeout "$TARGET_TIMEOUT"}'
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGTERM
KillMode=control-group
WorkingDirectory=%h

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=%h/.config/tunnelproxy

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tunnelproxy-%i

[Install]
WantedBy=default.target
